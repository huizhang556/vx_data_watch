VX_DATA_DIR=./data
VX_DATABASE_URL=sqlite:///./data/vx_data.db
VX_BIND_ADDRESS=127.0.0.1
VX_PORT=8000
VX_COOKIE_SECURE=false
VX_SESSION_DAYS=14
VX_MAX_UPLOAD_MB=20
# VX_MASTER_KEY=base64-encoded-32-byte-key
VX_IMAGE=docker.io/litehub/vx-data-watch:0.3.9
# VX_UPDATE_REPOSITORY=litehub/vx-data-watch
# Docker Hub 网络受限时可临时指定可信镜像代理：
# VX_NODE_IMAGE=docker.1ms.run/library/node:24-alpine
# VX_PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim
VX_REGISTRATION_ENABLED=false
# SMTP（开启邮箱注册或密码重置时必须配置）
# VX_SMTP_HOST=smtp.example.com
# VX_SMTP_PORT=587
# VX_SMTP_USERNAME=your-account
# VX_SMTP_PASSWORD=your-password
# VX_SMTP_FROM=VX Data Watch <noreply@example.com>
# VX_SMTP_STARTTLS=true
# VX_SMTP_SSL=false
# 人机验证：目前支持 Cloudflare Turnstile
VX_CAPTCHA_ENABLED=false
# VX_CAPTCHA_PROVIDER=turnstile
# VX_CAPTCHA_SITE_KEY=
# VX_CAPTCHA_SECRET_KEY=
# VX_VERIFICATION_CODE_MINUTES=10
